# Copy to docker/.env; never commit secrets or private TLS keys.
TGOAT_POSTGRES_DB=tgoat
TGOAT_POSTGRES_USER=tgoat
TGOAT_POSTGRES_PASSWORD=replace-with-strong-password
TGOAT_AUTH_SECRET=replace-with-long-random-secret
TGOAT_CERT_DIR=/absolute/path/to/private/cert-directory
TGOAT_HTTPS_PORT=8443
TGOAT_HTTP_PORT=8080
# Optional: explicit historical-source simulator on the NORMAL PostgreSQL stack.
# Start it with: docker compose --profile simulation up -d --build
TGOAT_SIMULATED_LIVE_MODE=0
# Schedule automatic pg_dump: docker compose --profile backups up -d --build
TGOAT_BACKUP_RETENTION_DAYS=14
TGOAT_BACKUP_INTERVAL_SECONDS=86400
# Demo accounts by default. For real test LDAP enable 'ldap' and supply a
# TLS-protected directory, CA bundle (or trusted system CA) and exact group map.
TGOAT_AUTH_PROVIDER=demo
TGOAT_LDAP_URL=
TGOAT_LDAP_BASE_DN=
TGOAT_LDAP_BIND_DN=
TGOAT_LDAP_BIND_PASSWORD=
TGOAT_LDAP_GROUP_MAP_JSON={}
TGOAT_SIMULATED_LIVE_INTERVAL_SECONDS=300
TGOAT_SIMULATED_LIVE_AUTO_START=0
TGOAT_LDAP_ADMIN_PASSWORD=replace-for-local-test
# Example group map (single line JSON):
# TGOAT_LDAP_GROUP_MAP_JSON={"ods":{"roles":["central_dispatcher"]},"is-admin":{"roles":["system_administrator"]},"complex-28":{"roles":["technician"],"scope_roots":[28]}}

# Optional public city-level forecast (NOT inferred object GPS):
# docker compose --profile weather up -d --build
# No customer endpoints/credentials are included.
TGOAT_LDAP_USER_FILTER=(uid={username})
TGOAT_LDAP_CA_FILE=
TGOAT_LDAP_INSECURE_LOCAL_TEST=0
